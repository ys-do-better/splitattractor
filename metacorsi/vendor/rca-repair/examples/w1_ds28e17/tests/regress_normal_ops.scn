# Normal traffic: a block read with a valid length, byte/word reads, a block write, plain reads.
slave 0x50 4 0x11 0x22 0x33 0x44
slave 0x51 0x5a 0xa5 0x01 0x02
op smbus_read_block 0x50 0x10
op smbus_read_byte_data 0x51 0x01
op smbus_read_word_data 0x51 0x02
op smbus_write_block 0x51 0x03 8
op i2c_read 0x51 4
